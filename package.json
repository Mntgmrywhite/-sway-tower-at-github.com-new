{
  "name": "sway-tower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "ios": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "snap": "tsx scripts/preview.ts",
    "music": "tsx scripts/music/render.ts",
    "music:check": "tsx scripts/music/check.ts",
    "sfx": "tsx scripts/music/sfx.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/zen-dots": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1"
  }
}
